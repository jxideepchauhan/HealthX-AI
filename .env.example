# HealthX AI Environment Variables Configuration

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="file:./dev.db"
# For PostgreSQL Production:
# DATABASE_URL="postgresql://healthx_user:healthx_secure_pass_2026@localhost:5432/healthx_db?schema=public"

# Redis Cache & Queue
REDIS_URL="redis://localhost:6379"

# Authentication Secrets
AUTH_SECRET="healthx-ai-super-secure-production-jwt-secret-key-2026"
OTP_PROVIDER_URL="https://api.sms-provider.example.com"
OTP_PROVIDER_KEY="otp_provider_secret_key"

# AI / LLM Engine
LLM_PROVIDER="local"
LLM_API_KEY=""

# OCR Engine
OCR_PROVIDER="local"
OCR_API_KEY=""
OCR_PROVIDER_URL="http://localhost:8000/ml/v1/ocr"

# Embedding Engine
EMBEDDING_PROVIDER="local"
EMBEDDING_API_KEY=""

# S3 Compatible Object Storage (AWS S3 or MinIO)
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="healthx-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ABDM / ABHA Gateway Integration
ABDM_BASE_URL="https://dev.abdm.gov.in/gateway"
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_ENVIRONMENT="SANDBOX"

# Machine Learning Service
ML_SERVICE_URL="http://localhost:8000"
